{
  "name": "nearcomponents",
  "version": "1.0.0",
  "description": "nearComponents",
  "packageManager": "pnpm@10.20.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "serve": "es-dev-server -n --preserve-symlinks --app-index index.html",
    "serve_prod": "es-dev-server -n --preserve-symlinks --open ru/",
    "build": "./build.sh",
    "dev:demo": "es-dev-server --node-resolve --watch --open /demo/ --app-index demo/index.html",
    "dev:app": "es-dev-server --node-resolve --watch --open /demo/app/ --app-index demo/app.html",
    "build:demo": "rollup -c"
  },
  "dependencies": {
    "lit-element": "^4.2.1",
    "lit-html": "^3.3.2"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.2",
    "es-dev-server": "^2.1.0",
    "rollup": "^4.47.1"
  },
  "author": "WJJ",
  "license": "ISC"
}
