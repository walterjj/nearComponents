#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/walter/idoneos/nearComponents/node_modules/.pnpm/es-dev-server@2.1.0/node_modules/es-dev-server/dist/node_modules:/home/walter/idoneos/nearComponents/node_modules/.pnpm/es-dev-server@2.1.0/node_modules/es-dev-server/node_modules:/home/walter/idoneos/nearComponents/node_modules/.pnpm/es-dev-server@2.1.0/node_modules:/home/walter/idoneos/nearComponents/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/walter/idoneos/nearComponents/node_modules/.pnpm/es-dev-server@2.1.0/node_modules/es-dev-server/dist/node_modules:/home/walter/idoneos/nearComponents/node_modules/.pnpm/es-dev-server@2.1.0/node_modules/es-dev-server/node_modules:/home/walter/idoneos/nearComponents/node_modules/.pnpm/es-dev-server@2.1.0/node_modules:/home/walter/idoneos/nearComponents/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../es-dev-server/dist/cli.js" "$@"
else
  exec node  "$basedir/../es-dev-server/dist/cli.js" "$@"
fi
